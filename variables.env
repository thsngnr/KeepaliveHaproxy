# Bu dosyayı doldurup scripts/install-*.sh içinde `source variables.env` ile
# kullan, veya placeholder'ları sed ile manuel değiştir:
#   sed -i "s/<VIP_IP>/192.0.2.50/g" lb-nodes/lb1/keepalived/keepalived.conf ...

VIP_IP=10.100.100.200

LB1_IP=10.100.100.203
LB2_IP=10.100.100.202
LB1_ROUTER_ID=LB1-haproxy-keepalived-1
LB2_ROUTER_ID=LB2-haproxy-keepalived-2
VRRP_VIRTUAL_ROUTER_ID=200
VRRP_INTERFACE=eth0

HF1_IP=10.100.100.211
HF2_IP=10.100.100.212
HF3_IP=10.100.100.213
HF1_NAME=splunk-hf-1
HF2_NAME=splunk-hf-2
HF3_NAME=splunk-hf-3

INDEXER_IP=10.100.100.161
# 10.100.100.161 REST API üzerinden üretildi (lb_shared_hec_token), ve
# hf1/hf2/hf3'ün splunk_httpinput/local/inputs.conf'una push edildi +
# splunk restart edildi. Üçünde de doğrulandı (HTTP 200 Success).
HEC_TOKEN=f094885c-3b07-4e2e-804e-82eadf891013

SYSLOG_PORT=514
HEC_PORT=8088
READYZ_PORT=9099
INDEXER_RECEIVING_PORT=9997
