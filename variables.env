# Bu dosyayı doldurup scripts/install-*.sh içinde `source variables.env` ile
# kullan, veya placeholder'ları sed ile manuel değiştir:
#   sed -i "s/<VIP_IP>/192.0.2.50/g" lb-nodes/lb1/keepalived/keepalived.conf ...
#
# UYARI: Bu dosyayı gerçek değerlerle doldurduktan sonra COMMIT ETME.
# .gitignore zaten engelliyor; yine de dikkatli ol (bkz. variables.env.local
# önerisi aşağıda).

VIP_IP=192.0.2.50
# VIP prefix uzunlugu. /32 ONERILIR: VIP, vrrp200 (VMAC) arayuzunde bagli bir
# subnet rotasi olusturmaz. /24 gibi gercek arayuzun prefix'inden DAR bir
# prefix verirsen (ornek: ens33 /23, VIP /24) kernel HF trafigini vrrp200 uzerinden
# ve VIP kaynak IP'siyle gonderir; DR health-check bozulur.
VIP_PREFIX=32

# VRRP sanal MAC (use_vmac vrrp200). Varsayilan: no.
# VMware (ESXi) / port-security'li switch'lerde "Forged Transmits" ve "MAC Address
# Changes" Reject ise sanal MAC (00:00:5e:00:01:xx) cikista DUSURULUR: keepalived
# ARP cevabini uretir ama istemci hic almaz, VIP dis dunyadan ping/ARP almaz.
# Bu durumda no birak. Altyapi sanal MAC'e izin veriyorsa (Proxmox, ESXi Accept)
# yes yapilabilir.
USE_VMAC=no

LB1_IP=192.0.2.11
LB2_IP=192.0.2.12
LB1_ROUTER_ID=LB1-haproxy-keepalived-1
LB2_ROUTER_ID=LB2-haproxy-keepalived-2
VRRP_VIRTUAL_ROUTER_ID=200
VRRP_INTERFACE=eth0

HF1_IP=192.0.2.21
HF2_IP=192.0.2.22
HF3_IP=192.0.2.23
HF1_NAME=splunk-hf-1
HF2_NAME=splunk-hf-2
HF3_NAME=splunk-hf-3

INDEXER_IP=192.0.2.100
HEC_TOKEN=00000000-0000-0000-0000-000000000000

SYSLOG_PORT=514
HEC_PORT=8088

# --- OPSIYONEL: Deployment Server yonlendirme (LB uzerinden <VIP>:DS_LISTEN_PORT -> DS_IP:DS_PORT) ---
# DS_IP bos birakilirsa HAProxy'ye hicbir sey eklenmez (varsayilan).
DS_IP=
DS_PORT=8089
DS_LISTEN_PORT=8089
# HEC TLS: 0 = duz HTTP (enableSSL=0), 1 = HEC HTTPS (Splunk varsayilani).
# HAProxy HEC icin mode tcp (passthrough) oldugundan TLS'e sonlandirmaz; istemci
# VIP:8088'e https ile baglanir, sertifikayi HF sunar. 1 ise HF'lerde
# readyz https ile yoklar. HF'lerde enableSSL de ayni degerde olmali.
HEC_SSL=0
READYZ_PORT=9099
# readyz /readyz/syslog disk kontrolu: DATA_DIR'in bulundugu diskte bos alan
# HEM bu yuzdenin HEM bu MB degerinin altina duserse HF syslog havuzundan cikar.
# DATA_DIR genelde Splunk ile ayni diskte; Splunk server.conf [diskUsage]
# minFreeSpace (varsayilan 5000 MB) altinda islerini durdurur. MB esigini onun
# biraz ustunde tut ki HF havuzdan Splunk durmadan once ciksin (ornek: 6000).
# Varsayilan 0 = MB kontrolu KAPALI (sadece yuzde; onceki davranis). Ayni diski
# paylasan ortamda Splunk'in disk kullanimi HF'yi syslog havuzundan cikarabilir;
# istemeyen kapali birakir.
READYZ_DISK_FREE_PCT_MIN=10
READYZ_DISK_FREE_MB_MIN=0
# HEC_SSL=1 (TLS passthrough) iken HAProxy HTTP header'larini goremez; indexer
# acknowledgment (useACK) kullanan istemcilerin ack sorgusu ayni HF'ye gitsin
# diye varsayilan "source" (ayni istemci IP -> ayni HF). useACK kullanilmiyorsa
# ve dagilim onemliyse "roundrobin" yapilabilir. HEC_SSL=0 iken kullanilmaz
# (o modda HAProxy channel header'ina gore yonlendirir).
HEC_TLS_BALANCE=source
# rsyslog loglarini <DATA_DIR>/<kaynak-ip>/ altina yazar (HF'lerde)
DATA_DIR=/data/log/splunk/syslog
# <DATA_DIR> altindaki ceyreklik .log dosyalarindan son yazimi bu kadar saatten
# eski olanlari hf-syslog-cleanup.timer (her ceyrek saat) siler. 0 = timer
# kurulmaz/kapatilir (ornek: HF'de zaten kendi cron/logrotate temizligin varsa).
SYSLOG_RETENTION_HOURS=5
# Splunk monitor input'unun yazacagi index
SYSLOG_INDEX=main
# rsyslog "splunk" ruleset kuyrugu (HF'lerde, 49-hf-syslog-listener.conf):
#   SYSLOG_QUEUE_SIZE    : kuyrukta tutulabilecek mesaj sayisi (RAM). Dolarsa
#                          UDP mesajlari duser, TCP gondericiler yavaslatilir.
#   SYSLOG_QUEUE_WORKERS : kuyrugu bosaltip dosyaya yazan thread sayisi
#   SYSLOG_QUEUE_BATCH   : bir worker'in tek seferde aldigi mesaj sayisi
SYSLOG_QUEUE_SIZE=100000
SYSLOG_QUEUE_WORKERS=2
SYSLOG_QUEUE_BATCH=1024
# Disk destekli kuyruk: yes ise RAM kuyrugu %80 dolunca fazlasi rsyslog spool
# dizinine (Ubuntu /var/spool/rsyslog, RHEL /var/lib/rsyslog) yazilir ve restart'ta
# RAM'deki mesajlar kaybolmaz. UDP socket buffer kaybini COZMEZ (o kuyruk
# oncesi; bkz. SYSLOG_UDP_RMEM_BYTES). Sistemin ana rsyslog kuyrugu da ayri bir
# dosyayla disk destekli olur; ikisi birlikte en fazla 2 x SYSLOG_QUEUE_MAX_DISK.
# Faydasi sinirli: sadece kisa yuk patlamalari ve rsyslog restart'i icin.
# - DATA_DIR yazilamaz/doluysa omfile mesaji kuyrukta TUTMAZ, hata verip atar;
#   bu durumda disk kuyrugu kaybi onlemez.
# - Spool dizini DATA_DIR/Splunk ile ayni diskteyse disk yavasligina da yardim
#   etmez, ustelik Splunk'in bos alanindan yer.
SYSLOG_QUEUE_DISK=no
SYSLOG_QUEUE_MAX_DISK=2g
# HF'de UDP socket alma buffer'i (byte): net.core.rmem_default (rsyslog imudp
# buffer boyutu vermedigi icin bunu kullanir) ve net.core.rmem_max (mevcut
# degerden kucukse) bu degere cekilir. Yuksek EPS'te UDP kaybini azaltir.
# Tum UDP soketlerine uygulanan bir UST SINIRDIR, onceden ayrilan bellek degil.
# 0 = dokunma (kurulumun ekledigi sysctl dosyasi varsa kaldirilir).
SYSLOG_UDP_RMEM_BYTES=33554432
INDEXER_RECEIVING_PORT=9997
