# Bu dosyayı doldurup scripts/install-*.sh içinde `source variables.env` ile
# kullan, veya placeholder'ları sed ile manuel değiştir:
#   sed -i "s/<VIP_IP>/192.0.2.50/g" lb-nodes/lb1/keepalived/keepalived.conf ...
#
# UYARI: Bu dosyayı gerçek değerlerle doldurduktan sonra COMMIT ETME.
# .gitignore zaten engelliyor; yine de dikkatli ol (bkz. variables.env.local
# önerisi aşağıda).

VIP_IP=192.0.2.50
# VIP prefix uzunlugu. /32 ONERILIR: VIP, vrrp200 (VMAC) arayuzunde bagli bir
# subnet rotasi olusturmaz. /24 gibi gercek arayuzun prefix'inden DAR bir
# prefix verirsen (ornek: ens33 /23, VIP /24) kernel HF trafigini vrrp200 uzerinden
# ve VIP kaynak IP'siyle gonderir; DR health-check bozulur.
VIP_PREFIX=32

# VRRP sanal MAC (use_vmac vrrp200). Varsayilan: no.
# VMware (ESXi) / port-security'li switch'lerde "Forged Transmits" ve "MAC Address
# Changes" Reject ise sanal MAC (00:00:5e:00:01:xx) cikista DUSURULUR: keepalived
# ARP cevabini uretir ama istemci hic almaz, VIP dis dunyadan ping/ARP almaz.
# Bu durumda no birak. Altyapi sanal MAC'e izin veriyorsa (Proxmox, ESXi Accept)
# yes yapilabilir.
USE_VMAC=no

LB1_IP=192.0.2.11
LB2_IP=192.0.2.12
LB1_ROUTER_ID=LB1-haproxy-keepalived-1
LB2_ROUTER_ID=LB2-haproxy-keepalived-2
VRRP_VIRTUAL_ROUTER_ID=200
VRRP_INTERFACE=eth0

# Heavy Forwarder listesi: HF SAYISI SERBEST (en az 1). IP'leri bosluk ayirarak yaz.
# HF_NAMES opsiyonel (HAProxy server adlari); bos ise splunk-hf-1, splunk-hf-2, ...
# uretilir. Doluysa HF_IPS ile ayni sayida ve ayni sirada olmali.
# HF eklemek/cikarmak icin listeyi guncelle ve HER IKI LB'de install-lb-node.sh'i
# tekrar calistir; yeni HF'de install-hf-node.sh'i calistir.
HF_IPS="192.0.2.21 192.0.2.22 192.0.2.23"
HF_NAMES="splunk-hf-1 splunk-hf-2 splunk-hf-3"

INDEXER_IP=192.0.2.100
HEC_TOKEN=00000000-0000-0000-0000-000000000000

SYSLOG_PORT=514
HEC_PORT=8088

# --- OPSIYONEL: Deployment Server yonlendirme (LB uzerinden <VIP>:DS_LISTEN_PORT -> DS_IP:DS_PORT) ---
# DS_IP bos birakilirsa HAProxy'ye hicbir sey eklenmez (varsayilan).
DS_IP=
DS_PORT=8089
DS_LISTEN_PORT=8089
# HEC TLS: 0 = duz HTTP (enableSSL=0), 1 = HEC HTTPS (Splunk varsayilani).
# HAProxy HEC icin mode tcp (passthrough) oldugundan TLS'e sonlandirmaz; istemci
# VIP:8088'e https ile baglanir, sertifikayi HF sunar. 1 ise HF'lerde
# readyz https ile yoklar. HF'lerde enableSSL de ayni degerde olmali.
HEC_SSL=0
READYZ_PORT=9099
# Splunk yonetim (splunkd mgmt) portu: hf-readyz 127.0.0.1:<SPLUNKD_PORT>'a TCP ile yoklar.
# Varsayilan 8089; web.conf'ta mgmtHostPort degistirildiyse (ornek 127.0.0.1:8090) buraya yaz.
# Ogrenmek icin: splunk btool web list settings | grep mgmtHostPort
SPLUNKD_PORT=8089
# rsyslog loglarini <DATA_DIR>/<kaynak-ip>/ altina yazar (HF'lerde)
DATA_DIR=/data/log/splunk/syslog
# firewalld (RHEL/Oracle Linux HF'lerde): yes ise install-hf-node.sh 514 tcp+udp'yi acar,
# 8088 (HEC) ve 9099 (hf-readyz) portlarini yalnizca LB1_IP/LB2_IP'ye acar. no ise sadece uyarir.
FIREWALLD_OPEN=no
# UDP alim tamponu (rsyslog imudp rcvbufSize; cekirdek rmem_max=25MB ile birlikte, 62-udp-rcvbuf.conf)
UDP_RCVBUF=25m
# rsyslog dynaFile onbellegi: AKTIF kaynak IP sayisindan BUYUK olmali (yoksa dosyalar surekli
# kapanip acilir). Her girdi 64 KB tampon tutar: 1000 girdi ~64 MB RAM, 2000 ~128 MB.
DYNAFILE_CACHE_SIZE=1000
INDEXER_RECEIVING_PORT=9997

# --- IPVS dagilim kontrolu / yeniden dengeleme (LB'lerde, 5 dk'da bir calisir) ---
# Bir HF kisa sureligine havuzdan cikip dondugunde IPVS mevcut akislari geri
# tasimaz; yuk tek HF'te kalir. Bu servis dagilimi olcer:
#   off   : kapali
#   alert : dengesizlikte syslog'a uyari yazar (logger -t ipvs-rebalance), islem yapmaz (VARSAYILAN)
#   auto  : dengesizlik 2 ust uste olcumde surerse master'da keepalived'i yeniden
#           baslatir; VRRP karsi LB'ye gecer, akislar yeniden dagilir (TCP
#           istemcileri yeniden baglanir). Karsi LB hazir degilse / cooldown
#           icindeyse islem yapmaz.
REBALANCE_MODE=alert
REBALANCE_SKEW_RATIO=0.5       # en az yuklu HF < bu oran x adil pay ise dengesiz
REBALANCE_MIN_CONNS=30         # toplam akis bundan azsa karar verme
REBALANCE_STABLE_SECS=600      # master olduktan bu kadar sn sonra degerlendir
REBALANCE_COOLDOWN_SECS=21600  # iki otomatik islem arasi min sure (6 saat)

# --- UDP one-packet scheduling (ops) ---
# no  : IPVS UDP akisini (kaynak IP:port) tek HF'e sabitler (300 sn bos kalana dek).
#       Tek yogun UDP kaynagi tum yukunu tek HF'e bindirir; HF havuzdan cikip donunce
#       akislar geri dagilmaz.
# yes : her datagram ayri zamanlanir; tek akis HF'lere esit bolunur, HF doniste aninda
#       dengelenir. Bedel: ayni kaynagin loglari 3 HF'e ve 3 dizine dagilir; LB'de
#       paket basina baglanti kaydi (yuksek pps'te LB CPU'sunu izle).
UDP_OPS=no
